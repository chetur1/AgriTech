# ============================================================
# AGRI SMART — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- Application ---
APP_NAME="AGRI SMART"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Install PostgreSQL from: https://www.postgresql.org/download/windows/
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrismart_db
DB_USER=agrismart_user
DB_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://agrismart_user:change-this-strong-password@localhost:5432/agrismart_db

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-another-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=uploads

# ============================================================
# OPTIONAL EXTERNAL SERVICES
# The app works locally WITHOUT any of the keys below.
# Add them only when you are ready for that integration.
# ============================================================

# --- Weather (Open-Meteo — FREE, no API key required) ---
# Open-Meteo provides free weather forecasts with no signup.
# https://open-meteo.com/
WEATHER_PROVIDER=open-meteo
# WEATHER_API_KEY=not-required-for-open-meteo

# --- Market Prices (AGMARKNET / data.gov.in) ---
# data.gov.in requires a free API key after registration.
# https://data.gov.in/
# AGMARKNET_API_KEY=your-data-gov-in-api-key-here

# --- Ollama (Local LLM — FREE, no API key) ---
# Install Ollama from: https://ollama.com/
# Then run: ollama pull phi3:mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# --- BHASHINI (Indian Languages) ---
# Free registration at: https://bhashini.gov.in/
# BHASHINI_USER_ID=your-user-id
# BHASHINI_API_KEY=your-api-key
# BHASHINI_PIPELINE_ID=your-pipeline-id

# --- Optional Cloud AI (NOT required for local dev) ---
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key

# --- Email (Optional — for notifications) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=AGRI SMART <noreply@agrismart.in>

# --- Redis (Optional — for caching/background tasks) ---
# REDIS_URL=redis://localhost:6379/0

# --- Cloudinary (Optional — for cloud image storage) ---
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
