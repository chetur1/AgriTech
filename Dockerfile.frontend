# ============================================================
# AGRI SMART — Production Frontend Dockerfile
# Stage 1: Build React Vite PWA app
# Stage 2: Serve optimized assets via high-performance Nginx
# ============================================================

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Cache package manifests
COPY frontend/package*.json ./

# Install dependencies cleanly
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build production bundle with PWA service worker
RUN npm run build

# Stage 2: Production Web Server
FROM nginx:1.25-alpine

# Remove default nginx configurations
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy custom Nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
